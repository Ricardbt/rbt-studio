# Normalize line endings: LF in repo, auto on checkout
* text=auto eol=lf

# Treat media as binary (no EOL normalization, no diff)
*.mp4 binary
*.mov binary
*.MP4 binary
*.png binary
*.PNG binary
*.jpg binary
*.JPG binary
*.jpeg binary
*.gif binary
*.pdf binary
*.PDF binary
*.docx binary
*.webp binary
